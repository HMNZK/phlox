new file mode 100644
index 0000000..aad78e4
--- /dev/null
+++ b/macos/Packages/TerminalUI/Sources/TerminalUI/Bug01Trace.swift
@@ -0,0 +1,28 @@
+import Foundation
+import OSLog
+
+/// BUG-01 実行時トレース用の一時ロガー。製品恒久コードではない。
+public enum Bug01Trace {
+    private static let logger = Logger(subsystem: "com.phlox.Phlox", category: "BUG01")
+    private static let path = "/tmp/phlox-bug01-repro/trace.log"
+
+    public static func log(_ message: String) {
+        let ts = String(format: "%.3f", Date().timeIntervalSince1970)
+        let line = "\(ts) [BUG01] \(message)"
+        print(line)
+        logger.notice("\(message, privacy: .public)")
+        let data = Data((line + "\n").utf8)
+        if !FileManager.default.fileExists(atPath: path) {
+            FileManager.default.createFile(atPath: path, contents: data)
+            return
+        }
+        guard let handle = FileHandle(forWritingAtPath: path) else { return }
+        defer { try? handle.close() }
+        _ = try? handle.seekToEnd()
+        try? handle.write(contentsOf: data)
+    }
+
+    public static func identity(_ object: AnyObject) -> String {
+        String(UInt(bitPattern: ObjectIdentifier(object)))
+    }
+}
