+def protect_strings_and_comments(src)
+  protected, strings = protect_strings(src)
+  comments = []
+  protected = protected.gsub(%r{/\*.*?\*/}m) do
+    comments << Regexp.last_match(0)
+    "__CMT#{comments.length - 1}__"
+  end
+  protected = protected.gsub(%r{//[^\n]*}) do
+    comments << Regexp.last_match(0)
+    "__CMT#{comments.length - 1}__"
+  end
+  [protected, strings, comments]
+end
+
+def restore_strings_and_comments(src, strings, comments)
+  restored = src.gsub(/__CMT(\d+)__/) { comments[Regexp.last_match(1).to_i] }
+  restore_strings(restored, strings)
+end
+
+def index_after_comment(src, i)
+  if src[i, 2] == "//"
+    n = src.index("\n", i)
+    return n ? n : src.length
+  end
+  if src[i, 2] == "/*"
+    n = src.index("*/", i + 2)
+    return n ? n + 2 : src.length
+  end
+  i
+end
+
+def find_prefix_outside_literals(src, prefix, start = 0)
+  i = start
+  plen = prefix.length
+  while i < src.length
+    if src[i, 3] == '"""' || src[i] == '"'
+      i = index_after_string(src, i)
+      next
+    end
+    if src[i, 2] == "//" || src[i, 2] == "/*"
+      i = index_after_comment(src, i)
+      next
+    end
+    return i if src[i, plen] == prefix
+    i += 1
+  end
+  nil
+end
+
+def matching_open_pair(src, close_idx, open_ch, close_ch)
+  depth = 0
+  i = close_idx
+  while i >= 0
+    if src[i] == close_ch
+      depth += 1
+    elsif src[i] == open_ch
+      depth -= 1
+      return i if depth == 0
+    end
+    i -= 1
+  end
+  nil
+end
+
+def matching_open_paren(src, close_idx)
+  matching_open_pair(src, close_idx, "(", ")")
+end
+
+def skip_ws_back(src, i)
+  i -= 1 while i > 0 && src[i - 1] =~ /\s/
+  i
+end
+
+TYPOGRAPHY_ELEMENT_HEADS = %w[Text Label Markdown titleContent header TextField HStack VStack ZStack Button Group].freeze
+
+def element_chain_head?(src, mod_idx)
+  i = skip_ws_back(src, mod_idx)
+  loop do
+    i = skip_ws_back(src, i)
+    return false if i <= 0
+    if src[i - 1] == "}"
+      open = matching_open_pair(src, i - 1, "{", "}")
+      return false unless open
+      i = open
+      next
+    end
+    if src[i - 1] == ")"
+      open = matching_open_paren(src, i - 1)
+      return false unless open
+      ident_end = skip_ws_back(src, open)
+      ident_start = ident_end
+      ident_start -= 1 while ident_start > 0 && src[ident_start - 1] =~ /[A-Za-z0-9_]/
+      ident = src[ident_start...ident_end]
+      if ident_start > 0 && src[ident_start - 1] == "."
+        i = ident_start - 1
+        next
+      end
+      return TYPOGRAPHY_ELEMENT_HEADS.include?(ident)
+    end
+    if src[i - 1] =~ /[A-Za-z0-9_]/
+      ident_end = i
+      ident_start = ident_end
+      ident_start -= 1 while ident_start > 0 && src[ident_start - 1] =~ /[A-Za-z0-9_]/
+      return TYPOGRAPHY_ELEMENT_HEADS.include?(src[ident_start...ident_end])
+    end
+    return false
+  end
+end
