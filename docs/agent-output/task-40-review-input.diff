+    next if cur_src.nil? || base_src.nil?
+    cur = extract_ui_strings(cur_src)
+    base = extract_ui_strings(base_src)
+    if cur[:identifier] != base[:identifier]
+      ng << "#{path} の AX identifier が凍結 blob から変化している"
+    end
+    if cur[:help] != base[:help]
+      ng << "#{path} の help 文字列が凍結 blob から変化している"
+    end
+    if cur[:copy] != base[:copy]
+      ng << "#{path} のコピー内容が凍結 blob から変化している"
+    end
+  end
+  ng
+end
