+def collect_modifier_args(src, method)
+  args = []
+  pos = 0
+  needle = ".#{method}("
+  while (i = find_prefix_outside_literals(src, needle, pos))
+    paren = src.index("(", i)
+    break unless paren
+    a = extract_balanced(src, paren, "(", ")")
+    break unless a
+    args << compact(a)
+    pos = paren + 1 + a.length + 1
+  end
+  args
+end
+
+def collect_labeled_strings(src, label)
+  args = []
+  pos = 0
+  while (i = find_prefix_outside_literals(src, label, pos))
+    rest_start = i + label.length
+    rest_start += 1 while rest_start < src.length && src[rest_start] =~ /\s/
+    if rest_start < src.length && (src[rest_start] == '"' || src[rest_start, 3] == '"""')
+      j = index_after_string(src, rest_start)
+      args << src[rest_start...j]
+      pos = j
+    else
+      pos = rest_start + 1
+    end
+  end
+  args
+end
+
+def extract_ui_strings(src)
+  code = strip_comments(src.to_s)
+  {
+    identifier: collect_modifier_args(code, "accessibilityIdentifier"),
+    help: collect_modifier_args(code, "help"),
+    copy: collect_labeled_strings(code, "copyAccessibilityIdentifier:") + collect_labeled_strings(code, "copyText:"),
+  }
+end
