    },
    "あと %@ で非表示になります": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides in %@"
          }
        }
      }
    },
    "今すぐ隠す": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Now"
          }
        }
      }
    },
    "新しい端末をつなぐ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a New Device"
          }
        }
      }
    },
    "QR にはフルアクセス権限のトークンが含まれます。60 秒後に自動的に非表示になります。iPhone アプリで読み取ると、同一 Tailscale ネットワーク経由で接続できます。「QR コードを表示」を押すたびに新しい端末として発行され、既存の端末は影響を受けません。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The QR code contains a token with full access. It hides automatically after 60 seconds. Scan it with the iPhone app to connect over the same Tailscale network. Each time you press “Show QR Code”, a new device is issued; existing devices aren't affected."
          }
        }
      }
    },
    "「%@」を失効させますか?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke “%@”?"
          }
        }
      }
    },
    "失効": {
      "extractionState": "manual",
      "localizations": {
        "en": {
