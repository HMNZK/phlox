  "strings": {
    "%@ の実行ファイルが見つかりませんでした。PATH と agents.json を確認してください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find the %@ executable. Check your PATH and agents.json."
          }
        }
      }
    },
